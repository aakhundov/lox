+ic_public void ic_set_is_complete( ic_is_complete_fun_t* is_complete, void* arg ) {
+  ic_env_t* env = ic_get_env(); if (env==NULL) return;
+  env->is_complete = is_complete;
+  env->is_complete_arg = arg;
 }
 
