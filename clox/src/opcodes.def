/*
all clox opcode names defined by an X-macro
to introduce new opcodes, add them to the list below

rules:

  - define constant opcodes with XC: short only (long will be generated)
  - define all XC(...) opcodes before the first X(...) opcode
*/

XC(CONSTANT)
XC(DEF_GLOBAL)
XC(GET_GLOBAL)
XC(SET_GLOBAL)
XC(SET_GLOBAL_POP)
XC(GET_PROP)
XC(SET_PROP)
XC(SET_PROP_POP)
XC(CLOSURE)
XC(CLASS)
XC(METHOD)
XC(INVOKE)

X(GET_LOCAL)
X(SET_LOCAL)
X(SET_LOCAL_POP)
X(GET_UPVALUE)
X(SET_UPVALUE)
X(SET_UPVALUE_POP)
X(CLOSE_UPVALUE)
X(NIL)
X(TRUE)
X(FALSE)
X(POP)
X(POP_N)
X(EQUAL)
X(NOT_EQUAL)
X(GREATER)
X(GREATER_EQUAL)
X(LESS)
X(LESS_EQUAL)
X(ADD)
X(SUBTRACT)
X(MULTIPLY)
X(DIVIDE)
X(NOT)
X(NEGATE)
X(PRINT)
X(PRINT_N)
X(JUMP_TRUE)
X(JUMP_FALSE)
X(JUMP_FALSE_POP)
X(JUMP)
X(LOOP)
X(CALL)
X(RETURN)
X(RETURN_NIL)
