/*
all clox opcode names defined by an X-macro
to introduce new opcodes, add them to the list below

rules:

  - define constant opcodes with XC: short, then long
  - define all XC(...) pairs before the first X(...) call
*/

XC(CONSTANT, CONSTANT_LONG)
XC(DEF_GLOBAL, DEF_GLOBAL_LONG)
XC(GET_GLOBAL, GET_GLOBAL_LONG)
XC(SET_GLOBAL, SET_GLOBAL_LONG)
XC(SET_GLOBAL_POP, SET_GLOBAL_POP_LONG)
XC(GET_PROP, GET_PROP_LONG)
XC(SET_PROP, SET_PROP_LONG)
XC(SET_PROP_POP, SET_PROP_POP_LONG)
XC(CLOSURE, CLOSURE_LONG)
XC(CLASS, CLASS_LONG)
XC(METHOD, METHOD_LONG)

X(GET_LOCAL)
X(SET_LOCAL)
X(SET_LOCAL_POP)
X(GET_UPVALUE)
X(SET_UPVALUE)
X(SET_UPVALUE_POP)
X(CLOSE_UPVALUE)
X(NIL)
X(TRUE)
X(FALSE)
X(POP)
X(POP_N)
X(EQUAL)
X(NOT_EQUAL)
X(GREATER)
X(GREATER_EQUAL)
X(LESS)
X(LESS_EQUAL)
X(ADD)
X(SUBTRACT)
X(MULTIPLY)
X(DIVIDE)
X(NOT)
X(NEGATE)
X(PRINT)
X(PRINT_N)
X(JUMP_TRUE)
X(JUMP_FALSE)
X(JUMP_FALSE_POP)
X(JUMP)
X(LOOP)
X(CALL)
X(RETURN)
X(RETURN_NIL)
