// gc-sweep: the same two measurements as gc-mark, with almost nothing alive.
// Marking has next to no work to do, so what is left is the sweep walking the
// object list and freeing it. Read the two files against each other: the
// difference between them is what the live set costs.
//
// The two collect rows deliberately do not run the same number of
// collections: with nothing alive a collection is orders of magnitude cheaper
// than one that has to mark the whole tree, so compare the two per collection
// rather than row against row.

var n_runs = 10;

// A measured time in milliseconds, rounded to two decimals and left-aligned in
// a fixed column. Both halves are needed for the rows to line up: print
// separates its arguments with a single space, and a number is written with
// its trailing zeros dropped, so the two decimals are assembled by hand.
fun column(value, width) {
  var ms = floor(value * 100000 + 0.5) / 100;
  var whole = floor(ms);
  var frac = floor((ms - whole) * 100 + 0.5);

  if (frac >= 100) {
    whole = whole + 1;
    frac = 0;
  }

  var tail = str(frac);
  if (frac < 10) tail = "0" + tail;

  var text = str(whole) + "." + tail;
  return text + repeat(" ", width - len(text));
}

// One untimed warm-up call, then n_runs timed ones: the warm-up brings the
// core up to speed and warms the caches, so the first timed run is not the
// outlier. The printed result is a checksum -- a change that makes the
// benchmark do less work shows up there instead of as a speedup.
fun bench(name, body) {
  body();

  var total = 0;
  var lo = 0;
  var hi = 0;
  var result = 0;

  for (var i = 0; i < n_runs; i = i + 1) {
    var start = clock();
    result = body();
    var elapsed = clock() - start;

    total = total + elapsed;
    if (i == 0 or elapsed < lo) lo = elapsed;
    if (elapsed > hi) hi = elapsed;
  }

  print name + repeat(" ", 21 - len(name)) + column(total / n_runs, 9)
      + column(lo, 9) + column(hi, 9) + str(result);
}
var n_churn = 265000;
var n_collect = 100000;

class Node {
  init(l, r) {
    this.l = l;
    this.r = r;
  }
}

fun churn() {
  var acc = 0;

  for (var i = 0; i < n_churn; i = i + 1) {
    var garbage = Node(nil, nil);
    acc = acc + 1;
  }

  return acc;
}

fun collect() {
  var acc = 0;

  for (var i = 0; i < n_collect; i = i + 1) {
    gc();
    acc = acc + 1;
  }

  return acc;
}

bench("gc-sweep.churn", churn);
bench("gc-sweep.collect", collect);
