var name = "declarations";

fun column(value, width) {
  var ms = floor(value * 100000 + 0.5) / 100;
  var whole = floor(ms);
  var frac = floor((ms - whole) * 100 + 0.5);

  if (frac >= 100) {
    whole = whole + 1;
    frac = 0;
  }

  var tail = str(frac);
  if (frac < 10) tail = "0" + tail;

  var text = str(whole) + "." + tail;
  return text + repeat(" ", width - len(text));
}

print name + repeat(" ", 21 - len(name)) + column(elapsed, 9)
    + column(elapsed, 9) + column(elapsed, 9) + str(f00000(1, 2) + f19999(1, 2));
